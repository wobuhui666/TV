<?xml version="1.0" encoding="utf-8"?>
<com.fongmi.android.tv.ui.custom.JetStreamPlaybackOverlayRootLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.fongmi.android.tv.ui.custom.JetStreamPlaybackTopBarLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="48dp"
        android:paddingTop="20dp"
        android:paddingEnd="48dp"
        android:paddingBottom="18dp"
        android:visibility="gone"
        tools:visibility="visible">

        <com.fongmi.android.tv.ui.custom.JetStreamPlaybackTitleTextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_toStartOf="@+id/clock"
            android:ellipsize="marquee"
            android:singleLine="true"
            tools:text="民視" />

        <com.fongmi.android.tv.ui.custom.JetStreamPlaybackMetaTextView
            android:id="@+id/size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/title"
            android:layout_alignStart="@+id/title"
            tools:text="1920 x 1080" />

        <com.fongmi.android.tv.ui.custom.JetStreamPlaybackClockTextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            tools:text="09:20:00" />

    </com.fongmi.android.tv.ui.custom.JetStreamPlaybackTopBarLayout>

    <com.fongmi.android.tv.ui.custom.JetStreamPlaybackPanelLayout
        android:id="@+id/error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <com.fongmi.android.tv.ui.custom.JetStreamPlaybackPanelIconView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_widget_error" />

        <com.fongmi.android.tv.ui.custom.JetStreamPlaybackBodyTextView
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            tools:text="@string/error_play_url" />

    </com.fongmi.android.tv.ui.custom.JetStreamPlaybackPanelLayout>

    <com.fongmi.android.tv.ui.custom.JetStreamPlaybackDigitalTextView
        android:id="@+id/digital"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        tools:text="05"
        tools:visibility="visible" />

    <com.fongmi.android.tv.ui.custom.JetStreamPlaybackPanelLayout
        android:id="@+id/center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <com.fongmi.android.tv.ui.custom.JetStreamPlaybackPanelIconView
            android:id="@+id/action"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_widget_play" />

        <com.fongmi.android.tv.ui.custom.JetStreamPlaybackTimeRowLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.fongmi.android.tv.ui.custom.JetStreamPlaybackTimeTextView
                android:id="@+id/position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="00:00:00" />

            <com.fongmi.android.tv.ui.custom.JetStreamPlaybackSecondaryTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="/" />

            <com.fongmi.android.tv.ui.custom.JetStreamPlaybackTimeTextView
                android:id="@+id/duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="00:00:00" />

        </com.fongmi.android.tv.ui.custom.JetStreamPlaybackTimeRowLayout>
    </com.fongmi.android.tv.ui.custom.JetStreamPlaybackPanelLayout>

    <com.fongmi.android.tv.ui.custom.JetStreamLiveBottomBarLayout
        android:id="@+id/bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="28dp"
        android:paddingEnd="48dp"
        android:paddingBottom="32dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.fongmi.android.tv.ui.custom.JetStreamLogoImageView
                android:id="@+id/logo"
                android:layout_width="44dp"
                android:layout_height="32dp"
                android:layout_marginEnd="16dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <com.fongmi.android.tv.ui.custom.JetStreamLiveChannelNumberTextView
                android:id="@+id/number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                tools:text="005" />

            <com.fongmi.android.tv.ui.custom.JetStreamLiveChannelNameTextView
                android:id="@+id/name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:textSize="24sp"
                tools:text="CCTV-1 综合" />

            <com.fongmi.android.tv.ui.custom.JetStreamPlaybackSecondaryTextView
                android:id="@+id/line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:textSize="13sp"
                tools:text="来源 1" />
        </LinearLayout>

        <com.fongmi.android.tv.ui.custom.JetStreamPlaybackSecondaryTextView
            android:id="@+id/play"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="16sp"
            tools:text="正在播放：人与自然" />
    </com.fongmi.android.tv.ui.custom.JetStreamLiveBottomBarLayout>
</com.fongmi.android.tv.ui.custom.JetStreamPlaybackOverlayRootLayout>
