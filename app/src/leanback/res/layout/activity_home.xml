<?xml version="1.0" encoding="utf-8"?>
<com.fongmi.android.tv.ui.custom.JetStreamPageRootLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.fongmi.android.tv.ui.custom.JetStreamPageBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.fongmi.android.tv.ui.custom.JetStreamPageProgressLayout
        android:id="@+id/progressLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.fongmi.android.tv.ui.custom.JetStreamVerticalGridView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:nextFocusUp="@id/nav"
            android:paddingTop="80dp"
            android:paddingBottom="48dp"
            app:focusOutEnd="true"
            app:focusOutFront="true" />
    </com.fongmi.android.tv.ui.custom.JetStreamPageProgressLayout>

    <com.fongmi.android.tv.ui.custom.JetStreamPageContentLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.fongmi.android.tv.ui.custom.JetStreamHomeLogoView
            android:id="@+id/logo"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="22dp"
            android:src="@drawable/ic_logo" />

        <com.fongmi.android.tv.ui.custom.JetStreamHomeNavView
            android:id="@+id/nav"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:nextFocusDown="@id/recycler" />

        <com.fongmi.android.tv.ui.custom.JetStreamHomeTitleView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:contentDescription="@string/home_change_source"
            android:ellipsize="end"
            android:focusable="false"
            android:gravity="center"
            android:maxWidth="120dp"
            android:singleLine="true"
            android:text="@string/app_name" />

        <com.fongmi.android.tv.ui.custom.JetStreamHomeClockTextView
            android:id="@+id/clock"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </com.fongmi.android.tv.ui.custom.JetStreamPageContentLayout>
</com.fongmi.android.tv.ui.custom.JetStreamPageRootLayout>
