<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="horizontal"
    android:padding="24dp">

    <com.fongmi.android.tv.ui.custom.CustomRecyclerView
        android:id="@+id/recycler"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:maxHeight="264dp"
        tools:itemCount="5"
        tools:listitem="@layout/adapter_site_home" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/action"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <com.fongmi.android.tv.ui.custom.JetStreamRoundChipImageView
            android:id="@+id/search"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/search"
            android:nextFocusDown="@id/change"
            android:padding="8dp"
            android:src="@drawable/ic_site_search"
            app:tint="@color/white" />

        <com.fongmi.android.tv.ui.custom.JetStreamRoundChipImageView
            android:id="@+id/change"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/search"
            android:nextFocusDown="@id/select"
            android:padding="8dp"
            android:src="@drawable/ic_site_change"
            app:tint="@color/white" />

        <com.fongmi.android.tv.ui.custom.JetStreamRoundChipImageView
            android:id="@+id/select"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/change"
            android:nextFocusDown="@id/cancel"
            android:padding="8dp"
            android:src="@drawable/ic_site_select"
            app:tint="@color/white" />

        <com.fongmi.android.tv.ui.custom.JetStreamRoundChipImageView
            android:id="@+id/cancel"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/select"
            android:nextFocusDown="@id/mode"
            android:padding="8dp"
            android:src="@drawable/ic_site_cancel"
            app:tint="@color/white" />

        <com.fongmi.android.tv.ui.custom.JetStreamRoundChipImageView
            android:id="@+id/mode"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/cancel"
            android:nextFocusDown="@id/mode"
            android:padding="8dp"
            app:tint="@color/white"
            tools:src="@drawable/ic_site_list" />

        <com.fongmi.android.tv.ui.custom.JetStreamRoundChipImageView
            android:id="@+id/sortUp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/msr_arrow_upward"
            app:tint="@color/white" />

        <com.fongmi.android.tv.ui.custom.JetStreamRoundChipImageView
            android:id="@+id/sortDown"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/msr_arrow_downward"
            app:tint="@color/white" />

        <com.fongmi.android.tv.ui.custom.JetStreamRoundChipImageView
            android:id="@+id/sortSave"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/msr_check"
            app:tint="@color/white" />

        <com.fongmi.android.tv.ui.custom.JetStreamRoundChipImageView
            android:id="@+id/sortSmart"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:contentDescription="智能排序"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/msr_auto_awesome_motion"
            app:tint="@color/white" />

        <com.fongmi.android.tv.ui.custom.JetStreamRoundChipImageView
            android:id="@+id/sortRestore"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/msr_refresh"
            app:tint="@color/white" />

    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
