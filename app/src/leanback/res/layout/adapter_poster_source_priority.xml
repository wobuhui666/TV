<?xml version="1.0" encoding="utf-8"?>
<com.fongmi.android.tv.ui.custom.JetStreamDiscoverPanelLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <com.fongmi.android.tv.ui.custom.JetStreamStrongLabelTextView
        android:id="@+id/rank"
        android:layout_width="38dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="17sp" />

    <com.fongmi.android.tv.ui.custom.JetStreamLabelTextView
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textSize="16sp" />

    <com.fongmi.android.tv.ui.custom.JetStreamButtonTextView
        android:id="@+id/priorityMoveUp"
        android:layout_width="60dp"
        android:layout_height="40dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="6dp"
        android:text="@string/poster_source_priority_up"
        android:textSize="13sp" />

    <com.fongmi.android.tv.ui.custom.JetStreamButtonTextView
        android:id="@+id/priorityMoveDown"
        android:layout_width="60dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="6dp"
        android:text="@string/poster_source_priority_down"
        android:textSize="13sp" />

    <com.fongmi.android.tv.ui.custom.JetStreamButtonTextView
        android:id="@+id/priorityRemove"
        android:layout_width="60dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="6dp"
        android:text="@string/poster_source_priority_remove"
        android:textSize="13sp" />
</com.fongmi.android.tv.ui.custom.JetStreamDiscoverPanelLayout>
