<?xml version="1.0" encoding="utf-8"?>
<com.fongmi.android.tv.ui.custom.JetStreamFeaturedVodLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="320dp"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <com.fongmi.android.tv.ui.custom.HomeArtworkView
        android:id="@+id/imageA"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.fongmi.android.tv.ui.custom.HomeArtworkView
        android:id="@+id/imageB"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible" />

    <com.fongmi.android.tv.ui.custom.JetStreamFeaturedLeftScrimView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.fongmi.android.tv.ui.custom.JetStreamFeaturedBottomScrimView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.fongmi.android.tv.ui.custom.JetStreamListItemContentLayout
        android:id="@+id/copy"
        android:layout_width="420dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="28dp"
        android:orientation="vertical">

        <com.fongmi.android.tv.ui.custom.JetStreamHeroMetaTextView
            android:id="@+id/kicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_hero_kicker"
            android:textSize="12sp" />

        <com.fongmi.android.tv.ui.custom.JetStreamHeroTitleTextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="36sp"
            android:textStyle="bold" />

        <com.fongmi.android.tv.ui.custom.JetStreamHeroMetaTextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="13sp" />

        <com.fongmi.android.tv.ui.custom.JetStreamHeroActionLayout
            android:id="@+id/action"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="20dp">

            <com.fongmi.android.tv.ui.custom.JetStreamInlineIconView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_featured_play" />

            <com.fongmi.android.tv.ui.custom.JetStreamHeroActionTextView
                android:id="@+id/actionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/home_hero_more"
                android:textSize="14sp" />
        </com.fongmi.android.tv.ui.custom.JetStreamHeroActionLayout>
    </com.fongmi.android.tv.ui.custom.JetStreamListItemContentLayout>

    <com.fongmi.android.tv.ui.custom.JetStreamListItemContentLayout
        android:id="@+id/indicator"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:orientation="horizontal" />
</com.fongmi.android.tv.ui.custom.JetStreamFeaturedVodLayout>
