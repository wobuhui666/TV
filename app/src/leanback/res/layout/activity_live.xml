<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

    <FrameLayout
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:clickable="true"
        android:focusable="true">

        <androidx.media3.ui.PlayerView
            android:id="@+id/player"
            style="@style/Player.Live"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:surface_type="none" />

        <include
            android:id="@+id/widget"
            layout="@layout/view_widget_live"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/control"
            layout="@layout/view_control_live"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <include
            android:id="@+id/progress"
            layout="@layout/view_progress"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <com.fongmi.android.tv.ui.custom.JetStreamLiveSidebarLayout
        android:id="@+id/recycler"
        android:layout_width="512dp"
        android:layout_height="match_parent"
        android:layout_marginStart="48dp"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="48dp"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        tools:visibility="visible">

        <com.fongmi.android.tv.ui.custom.JetStreamPlaybackSectionTitleView
            android:id="@+id/liveGuideTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/playback_live_guide"
            android:textSize="24sp" />

        <com.fongmi.android.tv.ui.custom.JetStreamPlaybackSecondaryTextView
            android:id="@+id/liveGuideSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="@string/playback_live_navigation"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <com.fongmi.android.tv.ui.custom.CustomLiveListView
                android:id="@+id/group"
                android:layout_width="152dp"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingEnd="12dp"
                tools:listitem="@layout/adapter_group" />

            <com.fongmi.android.tv.ui.custom.CustomLiveListView
                android:id="@+id/channel"
                android:layout_width="312dp"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="4dp"
                tools:listitem="@layout/adapter_channel" />

            <com.fongmi.android.tv.ui.custom.CustomLiveListView
                android:id="@+id/epgData"
                android:layout_width="464dp"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:visibility="gone"
                tools:listitem="@layout/adapter_epg_data" />
        </LinearLayout>
    </com.fongmi.android.tv.ui.custom.JetStreamLiveSidebarLayout>
</FrameLayout>
