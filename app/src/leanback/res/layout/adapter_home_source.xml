<?xml version="1.0" encoding="utf-8"?>
<com.fongmi.android.tv.ui.custom.JetStreamListItemContentLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.fongmi.android.tv.ui.custom.JetStreamSectionHeaderView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <com.fongmi.android.tv.ui.custom.JetStreamButtonTextView
            android:id="@+id/library"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:text="@string/home_tab_library" />
    </LinearLayout>

    <com.fongmi.android.tv.ui.custom.JetStreamSupportingLabelTextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="48dp"
        android:textSize="14sp" />

    <com.fongmi.android.tv.ui.custom.JetStreamChipRow
        android:id="@+id/actions"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="42dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="42dp"
        android:visibility="gone" />

    <androidx.leanback.widget.HorizontalGridView
        android:id="@+id/posters"
        android:layout_width="match_parent"
        android:layout_height="254dp"
        android:layout_marginTop="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="48dp"
        android:paddingTop="12dp"
        android:paddingEnd="48dp"
        android:paddingBottom="12dp"
        app:focusOutEnd="true"
        app:focusOutFront="true" />
</com.fongmi.android.tv.ui.custom.JetStreamListItemContentLayout>
