<?xml version="1.0" encoding="utf-8"?>
<com.fongmi.android.tv.ui.custom.JetStreamVodCardRootLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="232dp"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <com.fongmi.android.tv.ui.custom.JetStreamVodPosterLayout
        android:id="@+id/poster"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:duplicateParentState="true">

        <com.fongmi.android.tv.ui.custom.JetStreamPosterImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.fongmi.android.tv.ui.custom.JetStreamVodPosterLayout>

    <com.fongmi.android.tv.ui.custom.JetStreamVodTitleTextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:singleLine="true"
        tools:text="蜘蛛侠：崭新之日" />

    <com.fongmi.android.tv.ui.custom.JetStreamSupportingLabelTextView
        android:id="@+id/meta"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:singleLine="true"
        android:textSize="12sp"
        tools:text="2026 · 电影" />
</com.fongmi.android.tv.ui.custom.JetStreamVodCardRootLayout>
