<?xml version="1.0" encoding="utf-8"?>
<com.fongmi.android.tv.ui.custom.HomeContinueCardLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="112dp"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/image"
        android:layout_width="112dp"
        android:layout_height="84dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:scaleType="fitCenter" />

    <com.fongmi.android.tv.ui.custom.JetStreamListItemContentLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="140dp"
        android:layout_marginEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:orientation="vertical">

        <com.fongmi.android.tv.ui.custom.JetStreamVodTitleTextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="top|start"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="16sp" />

        <com.fongmi.android.tv.ui.custom.JetStreamSupportingLabelTextView
            android:id="@+id/remark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="12sp" />

        <com.fongmi.android.tv.ui.custom.JetStreamSupportingLabelTextView
            android:id="@+id/remaining"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:textSize="12sp" />
    </com.fongmi.android.tv.ui.custom.JetStreamListItemContentLayout>

    <com.fongmi.android.tv.ui.custom.HomeWatchProgressView
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="bottom" />

    <com.fongmi.android.tv.ui.custom.JetStreamPosterOverlayImageView
        android:id="@+id/delete"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/ic_vod_delete"
        android:visibility="gone" />
</com.fongmi.android.tv.ui.custom.HomeContinueCardLayout>
