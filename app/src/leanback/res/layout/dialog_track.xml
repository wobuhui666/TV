<?xml version="1.0" encoding="utf-8"?>
<com.fongmi.android.tv.ui.custom.JetStreamPlaybackSheetLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.fongmi.android.tv.ui.custom.JetStreamSheetHeaderView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="8dp"
        tools:text="選擇字幕" />

    <com.fongmi.android.tv.ui.custom.JetStreamDialogContentLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="0dp"
        android:paddingBottom="16dp">

        <com.fongmi.android.tv.ui.custom.MaterialPlaybackIconButton
            android:id="@+id/choose"
            android:contentDescription="@string/setting_choose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:focusable="true"
            app:icon="@drawable/ic_action_choose"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.fongmi.android.tv.ui.custom.MaterialPlaybackIconButton
            android:id="@+id/subtitle"
            android:contentDescription="@string/play_subtitle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:focusable="true"
            app:icon="@drawable/ic_action_subtitle"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.fongmi.android.tv.ui.custom.MaterialPlaybackIconButton
            android:id="@+id/offset"
            android:contentDescription="@string/offset_setting"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:focusable="true"
            app:icon="@drawable/ic_action_offset"
            android:visibility="gone"
            tools:visibility="visible" />

    </com.fongmi.android.tv.ui.custom.JetStreamDialogContentLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/search"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:text="@string/assrt_search_title"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/effects"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:text="@string/audio_effect_title"
        android:visibility="gone" />

    <com.fongmi.android.tv.ui.custom.JetStreamDialogListRecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        app:jetStreamListFramed="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/adapter_track" />

</com.fongmi.android.tv.ui.custom.JetStreamPlaybackSheetLayout>
