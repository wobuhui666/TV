<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/libraryRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/jetstream_background">
    <com.fongmi.android.tv.ui.custom.LibraryScrollView android:id="@+id/libraryScroll" android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:clipToPadding="false" android:clipChildren="false" android:overScrollMode="never">
        <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="40dp" android:clipChildren="false">
            <com.fongmi.android.tv.ui.custom.LibraryHeroFrame android:id="@+id/hero" android:layout_width="match_parent" android:layout_height="320dp" android:clipChildren="true" android:clipToPadding="true">
                <ImageView android:id="@+id/backdrop" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="@null" />
                <ImageView android:id="@+id/blurredBackdrop" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:alpha="0" android:contentDescription="@null" />
                <com.fongmi.android.tv.ui.custom.LibraryHeroScrim android:id="@+id/scrim" android:layout_width="match_parent" android:layout_height="match_parent" />
                <TextView android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_marginEnd="48dp" android:layout_marginTop="24dp" android:textSize="14sp" android:textColor="#FFFFFF" />
                <LinearLayout android:id="@+id/heroInformation" android:layout_width="540dp" android:layout_height="wrap_content" android:layout_gravity="start|bottom" android:layout_marginStart="48dp" android:layout_marginBottom="90dp" android:orientation="vertical">
                    <ImageView android:id="@+id/logo" android:layout_width="260dp" android:layout_height="68dp" android:layout_marginBottom="12dp" android:scaleType="fitStart" android:visibility="gone" android:contentDescription="@null" />
                    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:textSize="32sp" android:textStyle="bold" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" android:textColor="#FFFFFF" />
                    <TextView android:id="@+id/meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:includeFontPadding="false" android:textColor="#D7D9E0" android:singleLine="true" android:ellipsize="end" />
                    <TextView android:id="@+id/seriesStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="13sp" android:includeFontPadding="false" android:textColor="#C3D5CB" android:singleLine="true" android:ellipsize="end" android:visibility="gone" />
                    <TextView android:id="@+id/ratings" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="13sp" android:includeFontPadding="false" android:textColor="#E4C983" android:singleLine="true" android:ellipsize="end" />
                    <TextView android:id="@+id/overview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textSize="14sp" android:includeFontPadding="false" android:lineSpacingExtra="3dp" android:maxLines="2" android:ellipsize="end" android:textColor="#C5C8D1" />
                </LinearLayout>
                <LinearLayout android:id="@+id/heroActions" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="start|bottom" android:layout_marginStart="48dp" android:layout_marginBottom="24dp" android:gravity="center_vertical" android:clipChildren="false" android:clipToPadding="false">
                    <TextView android:id="@+id/play" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="190dp" android:maxWidth="320dp" android:layout_marginEnd="12dp" android:paddingStart="24dp" android:paddingEnd="24dp" android:focusable="true" android:focusableInTouchMode="true" android:gravity="center" android:singleLine="true" android:ellipsize="end" android:text="@string/library_play" android:textSize="15sp" android:textStyle="bold" android:textColor="#17171C" android:background="@drawable/library_play_button" android:nextFocusRight="@id/source" />
                    <TextView android:id="@+id/source" android:layout_width="96dp" android:layout_height="48dp" android:layout_marginEnd="12dp" android:focusable="true" android:focusableInTouchMode="true" android:gravity="center" android:text="@string/library_sources_action" android:textSize="14sp" android:textColor="#E3E3E8" android:background="@drawable/library_hero_action" android:nextFocusLeft="@id/play" android:nextFocusRight="@id/keep" />
                    <ImageButton android:id="@+id/keep" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="12dp" android:src="@drawable/msr_bookmark_border" app:tint="#E3E3E8" android:padding="12dp" android:background="@drawable/library_hero_action" android:contentDescription="@string/keep" android:nextFocusLeft="@id/source" android:nextFocusRight="@id/more" />
                    <ImageButton android:id="@+id/more" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/msr_info" app:tint="#E3E3E8" android:padding="12dp" android:background="@drawable/library_hero_action" android:contentDescription="@string/library_more" />
                </LinearLayout>
            </com.fongmi.android.tv.ui.custom.LibraryHeroFrame>
            <LinearLayout android:id="@+id/sections" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="48dp" android:paddingEnd="48dp" android:clipChildren="false" android:clipToPadding="false" />
        </LinearLayout>
    </com.fongmi.android.tv.ui.custom.LibraryScrollView>
    <FrameLayout android:id="@+id/libraryHeader" android:layout_width="match_parent" android:layout_height="72dp" android:layout_gravity="top" android:clipChildren="false">
        <com.fongmi.android.tv.ui.custom.LibraryFrostedSurface android:id="@+id/headerSurface" android:layout_width="match_parent" android:layout_height="match_parent" />
        <TextView android:id="@+id/headerTitle" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="104dp" android:paddingEnd="104dp" android:gravity="center" android:textSize="16sp" android:textStyle="bold" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" android:textColor="#FFFFFF" android:alpha="0" android:importantForAccessibility="no" />
        <View android:id="@+id/headerDivider" android:layout_width="match_parent" android:layout_height="1dp" android:layout_gravity="bottom" android:background="#16FFFFFF" android:alpha="0" android:importantForAccessibility="no" />
    </FrameLayout>
</FrameLayout>
