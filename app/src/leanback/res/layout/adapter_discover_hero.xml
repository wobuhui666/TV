<?xml version="1.0" encoding="utf-8"?>
<com.fongmi.android.tv.ui.custom.JetStreamDiscoverImmersiveHeroLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="436dp"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <com.fongmi.android.tv.ui.custom.JetStreamDiscoverArtworkLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.fongmi.android.tv.ui.custom.JetStreamDiscoverHeroImageView
            android:id="@+id/imageA"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:src="@drawable/wallpaper_1" />

        <com.fongmi.android.tv.ui.custom.JetStreamDiscoverHeroImageView
            android:id="@+id/imageB"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.fongmi.android.tv.ui.custom.JetStreamDiscoverLeftScrimView
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.fongmi.android.tv.ui.custom.JetStreamDiscoverBottomScrimView
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </com.fongmi.android.tv.ui.custom.JetStreamDiscoverArtworkLayout>

    <LinearLayout
        android:id="@+id/details"
        android:layout_width="540dp"
        android:layout_height="match_parent"
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp"
        android:visibility="invisible"
        tools:visibility="visible">

        <com.fongmi.android.tv.ui.custom.JetStreamSupportingLabelTextView
            android:id="@+id/source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="TMDB · 今日趋势" />

        <com.fongmi.android.tv.ui.custom.JetStreamHeroTitleTextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="44sp"
            android:textStyle="bold"
            tools:text="电影主视觉标题" />

        <com.fongmi.android.tv.ui.custom.JetStreamHeroMetaTextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="2026  ·  8.7分  ·  电影" />

        <com.fongmi.android.tv.ui.custom.JetStreamBodyTextView
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:textSize="16sp"
            tools:text="沉浸式主视觉会展示影片简介，并在内容轮播时自然过渡。" />

        <com.fongmi.android.tv.ui.custom.JetStreamHeroActionLayout
            android:id="@+id/action"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="16dp">

            <com.fongmi.android.tv.ui.custom.JetStreamInlineIconView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_featured_play" />

            <com.fongmi.android.tv.ui.custom.JetStreamHeroActionTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="@string/discover_view_details" />
        </com.fongmi.android.tv.ui.custom.JetStreamHeroActionLayout>
    </LinearLayout>

    <com.fongmi.android.tv.ui.custom.JetStreamHeroIndicatorLayout
        android:id="@+id/indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="28dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp"
        tools:visibility="visible" />

</com.fongmi.android.tv.ui.custom.JetStreamDiscoverImmersiveHeroLayout>
