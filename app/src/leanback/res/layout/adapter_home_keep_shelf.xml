<?xml version="1.0" encoding="utf-8"?>
<com.fongmi.android.tv.ui.custom.JetStreamListItemContentLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.fongmi.android.tv.ui.custom.JetStreamSectionHeaderView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/home_keep_shelf_title" />

        <com.fongmi.android.tv.ui.custom.JetStreamButtonTextView
            android:id="@+id/keepMore"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/home_keep_shelf_more"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.leanback.widget.HorizontalGridView
        android:id="@+id/keepPosters"
        android:layout_width="match_parent"
        android:layout_height="254dp"
        android:layout_marginTop="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="48dp"
        android:paddingTop="12dp"
        android:paddingEnd="48dp"
        android:paddingBottom="12dp"
        app:focusOutEnd="true"
        app:focusOutFront="true" />

    <LinearLayout
        android:id="@+id/keepFailure"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.fongmi.android.tv.ui.custom.JetStreamSupportingLabelTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:text="@string/home_keep_shelf_failed"
            android:textSize="14sp" />

        <com.fongmi.android.tv.ui.custom.JetStreamButtonTextView
            android:id="@+id/keepRetry"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/home_keep_shelf_retry" />
    </LinearLayout>
</com.fongmi.android.tv.ui.custom.JetStreamListItemContentLayout>
