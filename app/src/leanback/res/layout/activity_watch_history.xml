<?xml version="1.0" encoding="utf-8"?>
<com.fongmi.android.tv.ui.custom.JetStreamPageRootLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
    <com.fongmi.android.tv.ui.custom.JetStreamPageBackgroundView android:layout_width="match_parent" android:layout_height="match_parent" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="48dp" android:paddingEnd="48dp" android:paddingTop="28dp" android:paddingBottom="28dp" android:clipChildren="false" android:clipToPadding="false">
        <com.fongmi.android.tv.ui.custom.JetStreamPageHeaderView android:layout_width="match_parent" android:layout_height="60dp" app:jetStreamTitle="@string/my_history" />
        <com.fongmi.android.tv.ui.custom.JetStreamSupportingLabelTextView android:id="@+id/hint" android:layout_width="match_parent" android:layout_height="36dp" android:text="@string/my_history_hint" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipChildren="false" android:clipToPadding="false">
            <com.fongmi.android.tv.ui.custom.JetStreamVerticalGridView android:id="@+id/recycler" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="12dp" android:paddingBottom="24dp" />
            <LinearLayout android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:visibility="gone">
                <com.fongmi.android.tv.ui.custom.JetStreamLargeBodyTextView android:id="@+id/empty_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/my_history_empty" />
                <com.fongmi.android.tv.ui.custom.JetStreamButtonTextView android:id="@+id/retry" android:layout_width="160dp" android:layout_height="48dp" android:layout_marginTop="24dp" android:text="@string/my_retry" android:focusable="true" android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</com.fongmi.android.tv.ui.custom.JetStreamPageRootLayout>
