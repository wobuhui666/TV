<?xml version="1.0" encoding="utf-8"?>
<com.fongmi.android.tv.ui.custom.JetStreamPageRootLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.fongmi.android.tv.ui.custom.JetStreamPageBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.fongmi.android.tv.ui.custom.JetStreamPageContentLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="48dp"
        android:paddingTop="32dp"
        android:paddingEnd="48dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="336dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="32dp"
            android:orientation="vertical">

            <com.fongmi.android.tv.ui.custom.JetStreamHeroTitleTextView
                android:layout_width="match_parent" android:layout_height="36dp"
                android:layout_marginBottom="12dp" android:text="@string/home_search"
                android:textSize="28sp" />

            <com.fongmi.android.tv.ui.custom.JetStreamSearchFieldLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:addStatesFromChildren="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="16dp">

                <com.fongmi.android.tv.ui.custom.JetStreamSearchMicView
                    android:id="@+id/mic"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="10dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusDown="@id/keyboard"
                    android:padding="10dp"
                    android:src="@drawable/ic_search_mic" />

                <com.fongmi.android.tv.ui.custom.JetStreamSearchInputView
                    android:id="@+id/keyword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:hint="@string/search_keyword"
                    android:imeOptions="actionDone"
                    android:inputType="textCapWords|textAutoCorrect|textAutoComplete"
                    android:maxLength="255"
                    android:nextFocusDown="@id/keyboard"
                    android:paddingStart="18dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:textCursorDrawable="@drawable/shape_cursor" />

            </com.fongmi.android.tv.ui.custom.JetStreamSearchFieldLayout>

            <com.fongmi.android.tv.ui.custom.JetStreamPageRecyclerView
                android:id="@+id/keyboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="7"
                tools:itemCount="36"
                tools:listitem="@layout/adapter_keyboard_text" />

        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical"
            android:clipChildren="false" android:clipToPadding="false">
        <com.fongmi.android.tv.ui.custom.JetStreamPageContentScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingEnd="4dp"
            android:paddingBottom="12dp">

            <com.fongmi.android.tv.ui.custom.JetStreamPageContentLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.fongmi.android.tv.ui.custom.JetStreamPageContentLayout
                    android:id="@+id/recordLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.fongmi.android.tv.ui.custom.JetStreamSectionHeaderView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/search_record" />

                    <com.fongmi.android.tv.ui.custom.JetStreamPageRecyclerView
                        android:id="@+id/recordRecycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="0dp"
                        tools:itemCount="6"
                        tools:listitem="@layout/adapter_search_record" />

                </com.fongmi.android.tv.ui.custom.JetStreamPageContentLayout>

                <com.fongmi.android.tv.ui.custom.JetStreamSectionHeaderView
                    android:id="@+id/word"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/search_hot" />

                <com.fongmi.android.tv.ui.custom.JetStreamPageRecyclerView
                    android:id="@+id/wordRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="0dp"
                    tools:itemCount="10"
                    tools:listitem="@layout/adapter_search_word" />

            </com.fongmi.android.tv.ui.custom.JetStreamPageContentLayout>
        </com.fongmi.android.tv.ui.custom.JetStreamPageContentScrollView>
            <include android:id="@+id/results" layout="@layout/view_search_results"
                android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:visibility="gone" />
        </LinearLayout>
    </com.fongmi.android.tv.ui.custom.JetStreamPageContentLayout>
</com.fongmi.android.tv.ui.custom.JetStreamPageRootLayout>
