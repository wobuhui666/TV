<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- 渐变背景 -->
    <gradient
        android:angle="90"
        android:startColor="#E000696A"
        android:endColor="#D000696A"
        android:type="linear" />
    
    <!-- 圆角 -->
    <corners android:radius="20dp" />
    
    <!-- 边框 -->
    <stroke
        android:width="1dp"
        android:color="#FF80D4D5" />
    
</shape>