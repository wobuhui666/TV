<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- 渐变背景 -->
    <gradient
        android:angle="135"
        android:startColor="#E0BA1A1A"
        android:centerColor="#D0BA1A1A"
        android:endColor="#C0BA1A1A"
        android:type="linear" />
    
    <!-- 圆角 -->
    <corners android:radius="20dp" />
    
    <!-- 边框 -->
    <stroke
        android:width="1dp"
        android:color="#40FFDAD6" />
    
</shape>