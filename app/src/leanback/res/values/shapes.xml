<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3 Shape Styles -->
    
    <!-- Rounded corners for cards -->
    <style name="ShapeAppearance.Material3.CardView" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">16dp</item>
    </style>
    
    <!-- Rounded corners for buttons -->
    <style name="ShapeAppearance.Material3.Button" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">24dp</item>
    </style>
    
    <!-- Rounded corners for chips -->
    <style name="ShapeAppearance.Material3.Chip" parent="ShapeAppearance.Material3.Corner.Full">
